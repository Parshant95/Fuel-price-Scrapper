# ─── Groq ───────────────────────────────────────────────
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama3-70b-8192

# ─── MongoDB ─────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/fuel_tracker
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/fuel_tracker

# ─── Scraper ─────────────────────────────────────────────
SCRAPE_SCHEDULE="0 7,18 * * *"      # 7 AM and 6 PM daily
SCRAPE_SOURCE_URL=https://www.mypetrolprice.com
SCRAPE_TIMEOUT_MS=15000
MAX_HTML_CHARS=14000                 # Groq context limit safety

# ─── API ─────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ─── Logging ─────────────────────────────────────────────
LOG_LEVEL=info
